{
  "name": "next-pathmap",
  "version": "1.1.29",
  "description": "Generate a JSON map of every route in a Next.js project",
  "keywords": [
    "next",
    "next.js",
    "nextjs",
    "routes",
    "pathmap",
    "pages",
    "app-router",
    "generator",
    "cli"
  ],
  "homepage": "https://github.com/wonkooklee/next-pathmap#readme",
  "bugs": "https://github.com/wonkooklee/next-pathmap/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonkooklee/next-pathmap.git"
  },
  "license": "MIT",
  "author": {
    "name": "Wonkook Lee",
    "email": "const.wonkook@gmail.com",
    "url": "https://github.com/wonkooklee"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "next-pathmap": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "globby": "^13.1.4",
    "picocolors": "^1.0.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^16.18.31",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.8",
    "typescript": "^5.0.4",
    "vitest": "^0.31.0"
  }
}
