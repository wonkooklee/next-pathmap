{
  "name": "next-pathmap",
  "version": "1.1.29",
  "description": "Pathmap Generator for Next.js Pages",
  "keywords": [
    "generator",
    "next.js",
    "next",
    "pages",
    "path",
    "pathmap",
    "route"
  ],
  "repository": "wonkooklee/next-pathmap",
  "license": "MIT",
  "author": {
    "name": "Wonkook Lee",
    "url": "https://github.com/wonkooklee",
    "email": "const.wonkook@gmail.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "next-pathmap": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "globby": "^13.1.4",
    "picocolors": "^1.0.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^16.18.31",
    "prettier": "^2.8.8",
    "typescript": "^5.0.4",
    "vitest": "^0.31.0"
  },
  "publishConfig": {
    "@wonkooklee:registry": "https://npm.pkg.github.com"
  }
}
